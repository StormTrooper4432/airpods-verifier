# Python
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# Environment
.venv/
venv/
.env

# Local artifacts
*.jpg
*.jpeg
*.png
*.heic
# NO exception for tests/sample_data/*.png. There used to be one, so that a
# synthetic fixture could be committed, and it became a loaded gun: every
# photograph dropped into that directory was tracked by default, and a `git
# add -A` published a real box label carrying a legible serial number. Nothing
# in tests/ tracks a .png today, so the exception was protecting nothing and
# costing that.
#
# A genuinely synthetic fixture can still be committed with `git add -f`, which
# is the point - putting an image into this repository should be a deliberate
# act, not something a wildcard does on your behalf. Photographs of real units
# belong in knowledge/real_* (blocked from every vision API) or in a numbered
# corpus subfolder, both of which are ignored.
extraction*.json

# Scraped corpus: other people's photos. Evaluate against them, don't republish.
corpus/
results/
# A second scoring run under a different model, same reasoning as results/:
# other people's listing photographs, and derived data that goes stale.
results_*/

# Reference photographs - genuine units and counterfeits alike. Measurements
# derived from them live in knowledge/*.yaml; the images themselves stay local.
knowledge/real_*/
knowledge/fake/

# macOS
.DS_Store
