---
import Guilloche from '../components/Guilloche.astro';
import { rosette, sealRing, strip } from '../lib/guilloche';
import '../styles/sheet.css';

/**
 * The lathe work, emitted once for the whole page.
 *
 * These are constant, and a page can hold four graded records. Left to the
 * components, each instance carried its own copy of the same 31 KB rosette.
 */
const ornament = [
  `.guilloche{--horizontal:${strip(false)};--vertical:${strip(true)};--depth:22px}`,
  `.grade-ground{--underprint:${rosette(300)}}`,
  `.seal-ring{--ring:${sealRing(132)}}`,
].join('');

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#e9edef" />
    <link rel="preload" as="font" type="font/woff2" crossorigin
          href="/fonts/Archivo-latin.woff2" />
    <link rel="preload" as="font" type="font/woff2" crossorigin
          href="/fonts/ArchivoNarrow-latin.woff2" />
    <link rel="icon" href="/mark.svg" type="image/svg+xml" />
    <style is:inline set:html={ornament}></style>
  </head>
  <body>
    <a class="skip" href="#examination">Skip to the examination</a>
    <div class="sheet">
      <Guilloche />
      <div class="sheet-body">
        <slot />
      </div>
    </div>

    <style>
      .skip {
        position: absolute;
        left: calc(var(--u) * 3);
        top: calc(var(--u) * -12);
        z-index: 10;
        background: var(--ink);
        color: var(--paper);
        padding: calc(var(--u) * 1.5) calc(var(--u) * 2);
        font-family: var(--narrow);
        text-transform: uppercase;
        letter-spacing: 0.14em;
        font-size: 12px;
        text-decoration: none;
        transition: top 180ms cubic-bezier(0.16, 1, 0.3, 1);
      }
      .skip:focus { top: calc(var(--u) * 3); }

      .sheet {
        position: relative;
        min-height: 100vh;
        background: var(--paper);
      }

      .sheet-body {
        position: relative;
        z-index: 1;
        max-width: 1560px;
        margin: 0 auto;
        padding: calc(var(--u) * 8) calc(var(--u) * 7) calc(var(--u) * 10);
      }

      @media (max-width: 720px) {
        .sheet-body { padding: calc(var(--u) * 6) calc(var(--u) * 3) calc(var(--u) * 8); }
      }

      /* Margins come from @page. Stripping the body padding without setting
         them printed the masthead hard against the trimmed edge. */
      @page {
        margin: 14mm 12mm;
      }
      @media print {
        .skip { display: none; }
        .sheet { min-height: 0; }
        .sheet-body { padding: 0; max-width: none; }
      }
    </style>
  </body>
</html>
