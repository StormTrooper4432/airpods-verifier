---
/** One struck mark. The same three glyphs the plot uses, at reading size. */
import type { Status } from '../data/sheet';

interface Props {
  status: Status;
  size?: number;
}
const { status, size = 18 } = Astro.props;
const kind = status === 'FAIL' ? 'fail' : status === 'PASS' ? 'pass' : 'unknown';
---

<svg class={`mk mk-${kind}`} width={size} height={size} viewBox="0 0 14 14"
     role="img" aria-label={status === 'UNKNOWN' ? 'not resolved' : status.toLowerCase()}>
  <rect x="0.7" y="0.7" width="12.6" height="12.6" class="mk-box" />
  {status === 'PASS' && <path d="M3 7.5 L6 10.5 L11.5 4" class="mk-tick" />}
  {status === 'FAIL' && <path d="M2.4 2.4 L11.6 11.6 M11.6 2.4 L2.4 11.6" class="mk-strike" />}
</svg>

<style>
  .mk { flex: none; display: block; }
  .mk-box { fill: none; stroke-width: 1.4; }
  .mk-tick, .mk-strike { fill: none; stroke-width: 2; stroke-linecap: square; }
  .mk-pass .mk-box { stroke: var(--intaglio); }
  .mk-pass .mk-tick { stroke: var(--intaglio); }
  .mk-fail .mk-box { stroke: var(--struck); }
  .mk-fail .mk-strike { stroke: var(--struck); }
  .mk-unknown .mk-box { stroke: var(--ink-soft); stroke-dasharray: 3 2.5; }
</style>
