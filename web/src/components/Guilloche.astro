---
/**
 * The security border: engine-turned waves along all four edges, drawn from
 * the shared lathe so the border and the underprint are the same instrument.
 */

---

<div class="guilloche" aria-hidden="true">
  <span class="g g-top"></span>
  <span class="g g-bottom"></span>
  <span class="g g-left"></span>
  <span class="g g-right"></span>
</div>

<style>
  .guilloche {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 2;
  }
  .g { position: absolute; opacity: 0.85; }
  .g-top,
  .g-bottom {
    left: 0;
    right: 0;
    height: var(--depth);
    background-image: var(--horizontal);
    background-repeat: repeat-x;
  }
  .g-top { top: 0; }
  .g-bottom { bottom: 0; transform: scaleY(-1); }
  .g-left,
  .g-right {
    top: 0;
    bottom: 0;
    width: var(--depth);
    background-image: var(--vertical);
    background-repeat: repeat-y;
  }
  .g-left { left: 0; }
  .g-right { right: 0; transform: scaleX(-1); }

  @media (max-width: 720px) {
    .g-left, .g-right { display: none; }
  }
  @media print {
    .guilloche { display: none; }
  }
</style>
