---
import Sheet from '../layouts/Sheet.astro';
import BoxNet from '../components/BoxNet.astro';
import Ledger from '../components/Ledger.astro';
import Grade from '../components/Grade.astro';
import Mark from '../components/Mark.astro';
import {
  blankLedger,
  plotPanel,
  PANELS,
  RULES,
  RULE_BY_PARAMETER,
  TOTAL_WEIGHT,
  type Finding,
  type PanelId,
} from '../data/sheet';
import { examine, shotsFrom, ExamineError } from '../lib/examine';

let result: Awaited<ReturnType<typeof examine>> | null = null;
let failure: { problem: string; recovery: string } | null = null;

if (Astro.request.method === 'POST') {
  try {
    result = await examine(shotsFrom(await Astro.request.formData()));
  } catch (err) {
    failure =
      err instanceof ExamineError
        ? { problem: err.message, recovery: err.recovery }
        : {
            problem: 'The examination stopped on an error the sheet did not expect.',
            recovery: 'Try again. If it repeats, the server log carries the detail.',
          };
  }
}

const items = result ? result.report.evidence_ledger : blankLedger();
const shown: PanelId[] = result ? result.panels : [];
const findings: Finding[] = items.map((item, i) => ({
  n: i + 1,
  parameter: item.parameter,
  status: item.status,
  panel: plotPanel(RULE_BY_PARAMETER[item.parameter], shown),
}));

/** Which surface unlocks the most evidence weight, computed from the rules. */
const weightBehind = (panel: PanelId) =>
  RULES.filter((r) => r.answerableFrom.includes(panel)).reduce((n, r) => n + r.weight, 0);
const startHere = PANELS.map((p) => ({ panel: p, weight: weightBehind(p.id) }))
  .filter((p) => p.weight > 0)
  .sort((a, b) => b.weight - a.weight)
  .slice(0, 2);

const examinedAt = result
  ? new Date().toISOString().slice(0, 16).replace('T', ' ')
  : null;

/**
 * A record number, so the sheet is a citable document rather than a view.
 * Derived from the findings themselves, so re-examining the same photographs
 * to the same result reproduces it. It is a local reference and nothing more:
 * no registry issues it, and /about says so.
 */
function recordNumber(report: NonNullable<typeof result>['report'], at: string): string {
  const basis =
    report.summary_verdict +
    report.confidence_score +
    report.evidence_ledger.map((i) => i.status[0]).join('') +
    at;
  let hash = 0x811c9dc5;
  for (const ch of basis) {
    hash ^= ch.charCodeAt(0);
    hash = Math.imul(hash, 0x01000193) >>> 0;
  }
  // Crockford-ish: no 0/O or 1/I, so a number read off a screen is unambiguous.
  const alphabet = '23456789ABCDEFGHJKLMNPQRSTUVWXYZ';
  let out = '';
  let n = hash;
  for (let i = 0; i < 6; i += 1) {
    out += alphabet[n % 32];
    n = Math.floor(n / 32);
  }
  return `AP2-${out.slice(0, 3)}-${out.slice(3)}`;
}

const record = result && examinedAt ? recordNumber(result.report, examinedAt) : null;

const fmt = (n: number) => (Number.isInteger(n) ? String(n) : n.toFixed(1));
---

<Sheet
  title="AirPods Pro 2 Examination Record"
  description="A graded examination record for AirPods Pro 2 packaging and hardware. Nine cited checks, run by a deterministic rules engine — never by a language model."
>
  <header class="masthead">
    <div class="masthead-title">
      <h1>
        <span class="masthead-product">AirPods Pro&nbsp;2</span>
        <span class="masthead-kind">Examination record</span>
      </h1>
      <p class="masthead-stand">
        A counterfeit carries a cloned serial that clears Apple&rsquo;s own coverage lookup.
        This record never asks Apple. It reads the printed box against Apple&rsquo;s published
        hardware matrix, and the four serials against each other.
      </p>
    </div>

    <dl class="record" id="record-fields">
      <div><dt class="caps">Record no.</dt><dd>{record ?? '——'}</dd></div>
      <div><dt class="caps">Examined</dt><dd>{examinedAt ?? '——'}</dd></div>
      <div><dt class="caps">Variant</dt><dd>{result?.variant ?? '——'}</dd></div>
      <div>
        <dt class="caps">Surfaces</dt>
        <dd><b>{shown.length}</b><span class="of">of</span><b>{PANELS.length}</b></dd>
      </div>
      <div>
        <dt class="caps">Checks on record</dt>
        <dd><b>{RULES.length}</b><span class="of">·</span><b>{fmt(TOTAL_WEIGHT)}</b>
          <span class="unit">weight</span></dd>
      </div>
    </dl>
  </header>

  <form
    class="examination"
    id="examination"
    method="POST"
    enctype="multipart/form-data"
    aria-describedby="upload-disclosure"
  >
    <section class="col-plot" aria-labelledby="plot-h">
      <h2 id="plot-h" class="section-h">Plot</h2>
      <p class="section-note fine">
        The carton laid flat, with the case and buds beneath it. Each finding is marked at
        the surface it was read from. A surface nobody photographed is drawn unexposed and
        stays on the record.
      </p>

      <BoxNet
        shown={shown}
        findings={result ? findings : []}
        showWeights={!result}
        graded={Boolean(result)}
        interactive={true}
      />

      <ul class="legend" aria-label="What the marks mean" hidden={!result}>
        <li><Mark status="PASS" size={16} /><span>Check ran, no finding</span></li>
        <li><Mark status="FAIL" size={16} /><span>Struck: the check failed</span></li>
        <li><Mark status="UNKNOWN" size={16} /><span>On the record, could not run</span></li>
      </ul>

      <div class="actions">
        <div class="actions-row">
          <button type="submit" class="run">Run the examination</button>
          <a class="restart" href="/" id="restart" hidden={!result}>Start a new record</a>
        </div>
        <p class="fine actions-note">
          Reading a set of photographs usually takes 10 to 90 seconds. The wait is the
          vision model&rsquo;s queue on Google&rsquo;s free tier, not the size of your
          photographs.
        </p>
        <p class="fine actions-note" id="upload-disclosure">
          Photographs are read by Google&rsquo;s Gemini free tier. Google may use free-tier
          content to improve its products. Your box label carries a serial &mdash; do not send
          a photograph you would not publish.
        </p>
      </div>

      <div id="notice-slot">
        {failure && (
          <div class="notice" role="alert">
            <p class="notice-head"><Mark status="FAIL" size={16} />{failure.problem}</p>
            <p class="notice-fix">{failure.recovery}</p>
          </div>
        )}
      </div>
    </section>

    <section class="col-findings" id="findings-col" aria-labelledby="findings-h" aria-live="polite">
      <h2 id="findings-h" class="sr-only">Findings</h2>

      <div class="examining" id="examining" hidden>
        <p class="examining-word">Examining</p>
        <div class="examining-rail" role="progressbar"
             aria-label="Examination in progress. The length is not known in advance.">
          <span></span><span></span><span></span><span></span>
          <span></span><span></span><span></span><span></span>
        </div>
        <p class="examining-stage" id="examining-stage" aria-live="polite">
          Downscaling each photograph and encoding it
        </p>
        <p class="fine examining-clock">
          <span id="examining-elapsed">0:00</span> elapsed
          <span class="sep" aria-hidden="true">/</span>
          the length is not known in advance, so no percentage is shown
        </p>
      </div>

      <div id="graded-slot">
      <Grade
        verdict={result?.report.summary_verdict ?? null}
        score={result?.report.confidence_score ?? null}
        items={items}
        striking={Boolean(result)}
      />
      <h3 class="section-h rows-h">Findings</h3>
      <Ledger items={items} striking={Boolean(result)} />
      </div>
    </section>
  </form>

  <section class="settle" id="settle" aria-labelledby="settle-h">
    <h2 id="settle-h" class="section-h">What would settle it</h2>
    {result && result.report.next_steps.length > 0 ? (
      <ol class="steps">
        {result.report.next_steps.map((step) => <li>{step}</li>)}
      </ol>
    ) : result ? (
      <p class="steps-none">
        Nothing further. Every check that these photographs can answer has been answered.
      </p>
    ) : (
      <ol class="steps">
        {startHere.map(({ panel, weight }) => (
          <li>
            Photograph <b>{panel.phrase}</b>.
            {panel.carries ? ` ${panel.carries}` : ''}
            <span class="steps-weight">
              {' '}Unlocks {fmt(weight)} of {fmt(TOTAL_WEIGHT)} evidence weight.
            </span>
          </li>
        ))}
      </ol>
    )}
  </section>

</Sheet>

<script>
  const form = document.querySelector<HTMLFormElement>('#examination');

  if (form) {
    /* Photo previews are progressive: without scripting the form still posts
       and the record still renders. */
    form.querySelectorAll<HTMLInputElement>('.panel-file').forEach((input) => {
      input.addEventListener('change', () => {
        const hit = input.closest<HTMLLabelElement>('.panel-hit');
        if (!hit) return;
        const cue = hit.querySelector<HTMLElement>('.panel-hit-cue');
        const existing = hit.querySelector<HTMLImageElement>('.panel-shot');
        if (existing?.src.startsWith('blob:')) URL.revokeObjectURL(existing.src);
        existing?.remove();

        const file = input.files?.[0];
        if (!file) {
          hit.classList.remove('is-loaded');
          return;
        }
        const img = new Image();
        img.className = 'panel-shot';
        img.alt = '';
        img.src = URL.createObjectURL(file);
        hit.prepend(img);
        hit.classList.add('is-loaded');
        if (cue) cue.textContent = 'replace';
      });
    });

    /* Submitting normally would navigate, and a navigation empties every file
       input. The next step this record gives is almost always "add one more
       photograph", so the sheet swaps the findings in place and keeps what the
       visitor already picked. */
    const swap = (from: Document, selector: string) => {
      const next = from.querySelector(selector);
      const here = document.querySelector(selector);
      if (next && here) here.innerHTML = next.innerHTML;
    };

    /**
     * What the pipeline is actually doing, in order. There is no percentage
     * here and there will not be one: the engine cannot know how long the
     * vision model's queue is, and a bar that fills at a guessed rate is the
     * same false precision this whole sheet exists to refuse. The elapsed
     * clock is the only number, and it is true.
     */
    const STAGES: [number, string][] = [
      [0, 'Downscaling each photograph and encoding it'],
      [3, 'Measuring sharpness locally \u2014 no model sees this step'],
      [6, 'Sending the photographs to the vision model'],
      [10, 'The model transcribes into a fixed schema. It has no verdict field'],
      [16, 'Reading model numbers, the copyright year and the serial line'],
      [24, 'Recording which surfaces the photographs actually show'],
      [34, 'Waiting on the free tier. This is the slow part, and it is not yours'],
      [60, 'Still waiting. Free-tier capacity is shared; runs have taken 90 seconds'],
      [120, 'Still waiting. Your photographs stay attached whatever happens next'],
    ];

    const panel = document.getElementById('examining');
    const stageEl = document.getElementById('examining-stage');
    const elapsedEl = document.getElementById('examining-elapsed');
    const graded = document.getElementById('graded-slot');

    let ticker: ReturnType<typeof setInterval> | undefined;

    const startProgress = () => {
      const began = Date.now();
      if (panel) panel.hidden = false;
      if (graded) graded.hidden = true;
      const tick = () => {
        const seconds = Math.floor((Date.now() - began) / 1000);
        if (elapsedEl) {
          elapsedEl.textContent =
            `${Math.floor(seconds / 60)}:${String(seconds % 60).padStart(2, '0')}`;
        }
        const stage = STAGES.filter(([at]) => at <= seconds).pop();
        if (stage && stageEl && stageEl.textContent !== stage[1]) stageEl.textContent = stage[1];
      };
      tick();
      ticker = setInterval(tick, 1000);
    };

    const stopProgress = () => {
      if (ticker) clearInterval(ticker);
      if (panel) panel.hidden = true;
      if (graded) graded.hidden = false;
    };

    form.addEventListener('submit', async (event) => {
      const run = form.querySelector<HTMLButtonElement>('.run');
      if (!run) return;
      event.preventDefault();

      const label = run.textContent;
      run.disabled = true;
      run.textContent = 'Examining\u2026';
      startProgress();

      try {
        const response = await fetch(form.action || location.pathname, {
          method: 'POST',
          body: new FormData(form),
          headers: { 'x-sheet-swap': '1' },
        });
        const parsed = new DOMParser().parseFromString(await response.text(), 'text/html');

        swap(parsed, '#findings-col');
        swap(parsed, '#settle');
        swap(parsed, '#record-fields');
        swap(parsed, '#notice-slot');

        /* The drawing is re-rendered with its marks; the overlay holding the
           file inputs and previews is deliberately left alone. */
        const nextPlot = parsed.querySelector('.plot-net');
        const herePlot = document.querySelector('.plot-net');
        if (nextPlot && herePlot) herePlot.replaceWith(nextPlot);

        document.querySelector('.legend')?.removeAttribute('hidden');
        /* The overlay is never replaced, so the plot is told here that its job
           has changed from collecting photographs to reading findings. */
        document.querySelector('.plot')?.classList.add('is-graded');
        document.getElementById('restart')?.removeAttribute('hidden');
        document.getElementById('findings-col')?.scrollIntoView({
          behavior: 'smooth',
          block: 'start',
        });
      } catch (error) {
        const slot = document.getElementById('notice-slot');
        if (slot) {
          slot.innerHTML =
            '<div class="notice" role="alert"><p class="notice-head">' +
            'The examination could not be sent.</p>' +
            '<p class="notice-fix">Check the connection and run it again.</p></div>';
        }
      } finally {
        stopProgress();
        run.disabled = false;
        run.textContent = label;
      }
    });
  }
</script>

<style>
  .section-h {
    font-family: var(--narrow);
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-size: 12px;
    font-weight: 700;
    color: var(--intaglio);
    margin: 0 0 calc(var(--u) * 1.5);
  }
  .section-note { margin: 0 0 calc(var(--u) * 3); max-width: 62ch; }
  .rows-h {
    padding-top: calc(var(--u) * 1);
    border-top: 2px solid var(--intaglio);
    margin-bottom: calc(var(--u) * 2);
  }

  /* Masthead ------------------------------------------------------------- */

  .masthead {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: calc(var(--u) * 6);
    align-items: end;
    padding-bottom: calc(var(--u) * 4);
    border-bottom: 2px solid var(--ink);
    margin-bottom: calc(var(--u) * 6);
  }

  .masthead h1 { margin: 0; display: grid; gap: calc(var(--u) * 0.5); }
  .masthead-product {
    display: block;
    font-family: var(--narrow);
    font-weight: 700;
    text-transform: uppercase;
    font-size: clamp(38px, 6.6vw, 88px);
    line-height: 0.88;
    letter-spacing: -0.006em;
  }
  .masthead-kind {
    display: block;
    font-family: var(--narrow);
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.3em;
    font-size: clamp(12px, 1.5vw, 17px);
    color: var(--intaglio);
  }
  .masthead-stand {
    margin: calc(var(--u) * 3) 0 0;
    max-width: 58ch;
    font-size: 17px;
    line-height: calc(var(--u) * 3.5);
  }

  .record {
    display: grid;
    /* One grid, shared edges: five fields over two rows of three, the sixth
       cell left empty. Auto columns sized each row to its own content read as
       a near-miss at alignment, which on the one block that has to look like a
       ruled form is worse than no alignment at all. */
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: calc(var(--u) * 2) calc(var(--u) * 4);
    margin: 0;
    text-align: right;
    min-width: 30rem;
  }
  .record > div { min-width: 0; }
  .record dt { font-size: 9.5px; color: var(--ink-soft); margin-bottom: 2px; }
  .record dd { margin: 0; font-size: 16px; font-weight: 500; white-space: nowrap; }
  .record b { font-weight: 700; }
  .of { padding: 0 0.4em; color: var(--ink-soft); font-weight: 400; }
  .unit { font-family: var(--narrow); color: var(--ink-soft); padding-left: 0.4em; font-size: 13px; }

  /* The examination ------------------------------------------------------ */

  .examination {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: calc(var(--u) * 8);
    align-items: start;
    margin-bottom: calc(var(--u) * 12);
  }

  .col-plot {
    position: sticky;
    top: calc(var(--u) * 3);
  }

  .legend {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: calc(var(--u) * 1) calc(var(--u) * 3);
    padding: 0;
    margin: calc(var(--u) * 3) 0 0;
    font-family: var(--narrow);
    font-size: 12px;
    color: var(--ink-soft);
  }
  .legend li { display: flex; align-items: center; gap: calc(var(--u) * 1); }

  .actions {
    margin-top: calc(var(--u) * 4);
    display: grid;
    gap: calc(var(--u) * 2);
    justify-items: start;
  }
  .actions-row {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    gap: calc(var(--u) * 2);
  }

  .restart {
    font-family: var(--narrow);
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-weight: 700;
    font-size: 14px;
    color: var(--ink);
    background: none;
    border: 2px solid var(--intaglio);
    padding: calc(var(--u) * 1.75) calc(var(--u) * 3);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    transition:
      background 160ms cubic-bezier(0.16, 1, 0.3, 1),
      color 160ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .restart:hover { background: var(--intaglio); color: var(--paper); }
  .restart[hidden] { display: none; }

  .to-method {
    margin: 0;
    padding-top: calc(var(--u) * 4);
    border-top: 2px solid var(--ink);
  }
  .to-method a {
    font-family: var(--narrow);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-weight: 700;
    font-size: 13px;
  }

  .run {
    font-family: var(--narrow);
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-weight: 700;
    font-size: 14px;
    color: var(--paper);
    background: var(--ink);
    border: 2px solid var(--ink);
    padding: calc(var(--u) * 1.75) calc(var(--u) * 4);
    cursor: pointer;
    transition:
      background 160ms cubic-bezier(0.16, 1, 0.3, 1),
      color 160ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .run:hover { background: var(--intaglio); border-color: var(--intaglio); }
  /* Examining -------------------------------------------------------------
     The record's own field, mid-fill. It takes the grade's place rather than
     appearing beside it, so the sheet has one state at a time. */

  .examining { margin: 0 0 calc(var(--u) * 4); }

  .examining-word {
    font-family: var(--narrow);
    font-weight: 700;
    text-transform: uppercase;
    font-size: clamp(26px, 3.6vw, 42px);
    line-height: 0.92;
    margin: 0;
    padding-bottom: calc(var(--u) * 1.5);
    color: var(--ink-soft);
    border-bottom: 3px solid var(--intaglio-hair);
  }

  /* Indeterminate by construction: eight fixed cells with a lit run passing
     along them. It says "working", never "this far along". */
  .examining-rail {
    display: flex;
    gap: 3px;
    height: calc(var(--u) * 2);
    margin: calc(var(--u) * 3) 0 calc(var(--u) * 2);
  }
  .examining-rail span {
    flex: 1;
    border: 1px solid var(--intaglio-hair);
    background: transparent;
    animation: rail-sweep 1.9s cubic-bezier(0.16, 1, 0.3, 1) infinite;
  }
  .examining-rail span:nth-child(1) { animation-delay: 0ms; }
  .examining-rail span:nth-child(2) { animation-delay: 110ms; }
  .examining-rail span:nth-child(3) { animation-delay: 220ms; }
  .examining-rail span:nth-child(4) { animation-delay: 330ms; }
  .examining-rail span:nth-child(5) { animation-delay: 440ms; }
  .examining-rail span:nth-child(6) { animation-delay: 550ms; }
  .examining-rail span:nth-child(7) { animation-delay: 660ms; }
  .examining-rail span:nth-child(8) { animation-delay: 770ms; }
  @keyframes rail-sweep {
    0%, 55%, 100% { background: transparent; border-color: var(--intaglio-hair); }
    18% { background: var(--intaglio); border-color: var(--intaglio); }
  }

  .examining-stage {
    margin: 0 0 calc(var(--u) * 1);
    max-width: 54ch;
    line-height: calc(var(--u) * 3);
  }
  .examining-clock { margin: 0; }
  .examining-clock .sep { padding: 0 0.5em; color: var(--intaglio); }
  #examining-elapsed {
    font-variant-numeric: tabular-nums;
    font-weight: 700;
    color: var(--ink);
  }

  /* With motion reduced the rail holds a steady lit state rather than
     freezing on whatever frame it happened to stop at. */
  @media (prefers-reduced-motion: reduce) {
    .examining-rail span {
      animation: none;
      background: var(--intaglio-hair);
      border-color: var(--intaglio-soft);
    }
  }

  .run:disabled { background: none; color: var(--ink-soft); border-color: var(--intaglio-hair); cursor: progress; }

  .actions-note { max-width: 56ch; margin: 0; }

  .notice {
    margin-top: calc(var(--u) * 3);
    padding: calc(var(--u) * 2) calc(var(--u) * 3);
    border: 2px solid var(--struck);
    max-width: 62ch;
  }
  .notice-head {
    display: flex;
    align-items: center;
    gap: calc(var(--u) * 1.5);
    margin: 0 0 calc(var(--u) * 1);
    font-weight: 600;
    color: var(--struck);
  }
  .notice-fix { margin: 0; color: var(--ink-soft); }

  /* Next steps ------------------------------------------------------------ */

  .settle { margin-bottom: calc(var(--u) * 12); max-width: 78ch; }
  .steps { margin: 0; padding-left: calc(var(--u) * 3); }
  .steps li { margin-bottom: calc(var(--u) * 2); line-height: calc(var(--u) * 3); }
  .steps li::marker { color: var(--intaglio); font-weight: 700; font-family: var(--narrow); }
  .steps-weight { color: var(--ink-soft); }
  .steps-none { margin: 0; color: var(--ink-soft); }

  /* Narrower ---------------------------------------------------------------
     The examination is one column on a phone, plot first: at a meet-up the
     buyer is adding photographs, not reading a register. */

  @media (max-width: 1100px) {
    .examination { grid-template-columns: minmax(0, 1fr); gap: calc(var(--u) * 7); }
    .col-plot { position: static; }
  }

  @media (max-width: 860px) {
    .masthead {
      grid-template-columns: minmax(0, 1fr);
      gap: calc(var(--u) * 4);
      align-items: start;
    }
    .record { text-align: left; min-width: 0; }
  }

  @media (max-width: 560px) {
    .record { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: calc(var(--u) * 2); }
